# Minimal Baresip v4 iOS configuration for SipSdk.
# Only modules built into BaresipCore.xcframework should be configured here.

poll_method             select

# SIP over UDP/TCP; TLS is disabled in the packaged engine.
sip_trans_bsize         128

# AudioUnit is the native iOS audio backend.
audio_player            audiounit,nil
audio_source            audiounit,nil
audio_srate             8000-48000
audio_channels          1-2

# RTP / jitter buffer
rtp_tos                 184
rtcp_enable             yes
rtcp_mux                no
jitter_buffer_delay     5-10

# Static modules included in the XCFramework build.
module                  g711.so
module                  audiounit.so
module                  stun.so
module                  turn.so
module                  ice.so
module                  srtp.so

# The account parser is temporary: it reads configured accounts and is then
# unloaded by conf_modules().
module_tmp              account.so
